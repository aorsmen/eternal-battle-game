    "@splidejs/react-splide": "^0.7.12",
    "@tanstack/react-query": "5.105.0",
    "@xyflow/react": "12.12.0",
    "gsap": "3.15.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-lazy-load-image-component": "^1.6.3",
    "react-router": "7.18.5",
    "recharts": "3.10.1",
    "unique-names-generator": "^4.7.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/jest-dom": "^7.0.1",
